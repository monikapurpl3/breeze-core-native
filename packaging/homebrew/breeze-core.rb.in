# Generated by packaging/homebrew/make-formula.sh for Breeze Core @VER@.
# Not edited by hand: every release regenerates it from breeze-core.rb.in.
class BreezeCore < Formula
  desc "LAN-first control for Midea air conditioners"
  homepage "https://aspic.salataputarica.hr.eu.org/breeze-core/"
  license "AGPL-3.0-or-later"

  # Prebuilt, the same tarballs the GitHub release carries. The Linux ones are
  # static musl binaries, so they run under Homebrew on any distribution.
  on_macos do
    depends_on macos: :ventura
    on_arm do
      url "@BASE@/breeze-core-@VER@-macos-arm64.tar.zst"
      sha256 "@SHA_MACOS_ARM64@"
    end
    on_intel do
      url "@BASE@/breeze-core-@VER@-macos-x86_64.tar.zst"
      sha256 "@SHA_MACOS_X86_64@"
    end
  end
  on_linux do
    on_arm do
      url "@BASE@/breeze-core-@VER@-linux-arm64.tar.zst"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "@BASE@/breeze-core-@VER@-linux-amd64.tar.zst"
      sha256 "@SHA_LINUX_AMD64@"
    end
  end

  def install
    libexec.install "breeze-core"
    # A wrapper rather than the binary itself, for two reasons. The CLI and the
    # service must use the same store directory, or `breeze-core pair` writes a
    # config.json the service never reads. And `brew services` has no
    # EnvironmentFile on either system, so the service reads breeze-core.env
    # here, as the packaged systemd unit does.
    (bin/"breeze-core").write <<~SH
      #!/bin/sh
      : "${AC_CONFIG_DIR:=#{etc}/breeze-core}"
      export AC_CONFIG_DIR
      if [ "$#" -eq 1 ] && [ "$1" = serve ] && [ -r "$AC_CONFIG_DIR/breeze-core.env" ]; then
        set -a
        . "$AC_CONFIG_DIR/breeze-core.env"
        set +a
        set -- serve --host "${BREEZE_HOST:-127.0.0.1}" --port "${BREEZE_PORT:-8420}" $BREEZE_OPTS
      fi
      exec "#{libexec}/breeze-core" "$@"
    SH
    chmod 0755, bin/"breeze-core"
    (pkgshare/"breeze-core.env").write <<~ENV
@ENV@
    ENV
    doc.install "README.md"
  end

  def post_install
    (etc/"breeze-core").mkpath
    (var/"log").mkpath
    # Never over an existing one: it holds the address you chose.
    env = etc/"breeze-core/breeze-core.env"
    cp pkgshare/"breeze-core.env", env unless env.exist?
  end

  def caveats
    <<~EOS
      Breeze Core keeps its files in #{etc}/breeze-core.

      1. Find your air conditioners and write the config:
           breeze-core pair
      2. Set the address in #{etc}/breeze-core/breeze-core.env.
         127.0.0.1 is this machine only; its LAN address lets phones in.
      3. Start it, now and at every login:
           brew services start breeze-core
         Then open http://<that address>:8420.

      brew services runs it as you: a launchd agent on macOS, a systemd user
      unit on Linux. On a Linux server, prefer the distribution packages on
      aspic, which run it as its own account from boot.
    EOS
  end

  service do
    run [opt_bin/"breeze-core", "serve"]
    keep_alive true
    log_path var/"log/breeze-core.log"
    error_log_path var/"log/breeze-core.log"
  end

  test do
    assert_match "breeze-core #{version}", shell_output("#{bin}/breeze-core --version")
  end
end
