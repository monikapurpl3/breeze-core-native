# breeze-core, built from source by rpmbuild.
#
# Generated by packaging/source/build-source.sh from breeze-core.spec.in, which
# is the file to edit. The scriptlets below are packaging/nfpm/scripts/, pasted
# in, so this is the same package as the one in the aspic repository: the same
# name, files, service account and scriptlets, and either replaces the other.
# What differs is the binary. This one is built here, by this distribution's
# Rust, and links this distribution's glibc; the repository's is static musl.

# The release profile strips the binary itself (strip = true in Cargo.toml), so
# there is no debug information to split out, and rpmbuild would otherwise stop
# on an empty debugsource list.
%global debug_package %{nil}
# Nor the /usr/lib/.build-id links rpm would otherwise add, which point into a
# debuginfo package that does not exist. The binary package has none either.
%global _build_id_links none
# rpm 4.19 and later turn every non-root owner in %files into a hard
# `Requires: user(breeze)` / `group(breeze)`, which only a package shipping a
# sysusers.d file can satisfy, so the rebuilt package would not install. The
# account is made by %pre, as in the repository package; this makes those
# requirements recommendations instead. Older rpm ignores it.
%global _use_weak_usergroup_deps 1

Name:           breeze-core
Version:        @VER@
Release:        @REL@%{?dist}
Summary:        Self-hosted, LAN-first control for Midea air conditioners
License:        AGPL-3.0-or-later
URL:            https://github.com/monikapurpl3/breeze-core-native
Source0:        breeze-core-%{version}.tar.xz
Source1:        breeze-core-%{version}-vendor.tar.xz

# 1.88 is the oldest Rust the dependencies accept (the ICU crates, by way of
# idna). gcc builds ring's C.
BuildRequires:  cargo >= 1.88
BuildRequires:  rust >= 1.88
BuildRequires:  gcc
# The %pre scriptlet creates the service account.
Requires(pre):  shadow-utils

%description
Self-hosted, LAN-first control for Midea air conditioners: a REST API and web
control panel with device-pairing authentication, server-side schedules and
temperature curves. Built from source with this distribution's Rust.

%prep
%autosetup -n breeze-core-%{version} -a 1
mkdir -p .cargo
# Build from the vendored crates and nothing else: builders run offline (mock
# always does), and a build that fetched crates.io would not be building the
# source it was given.
printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "vendor"\n' > .cargo/config.toml

%build
export BREEZE_COMMIT=@COMMIT@
cargo build --release --locked --offline -p breeze-core

%check
cargo test --locked --offline --workspace

%install
install -Dm0755 target/release/breeze-core %{buildroot}/usr/bin/breeze-core
install -d %{buildroot}/usr/lib/breeze-core
ln -s /usr/bin/breeze-core %{buildroot}/usr/lib/breeze-core/breeze-core
install -Dm0644 packaging/nfpm/breeze-core.service %{buildroot}/usr/lib/systemd/system/breeze-core.service
install -d -m0750 %{buildroot}/etc/breeze-core
install -m0640 packaging/nfpm/breeze-core.env %{buildroot}/etc/breeze-core/breeze-core.env
install -Dm0644 README.md %{buildroot}/usr/share/doc/breeze-core/README.md
install -Dm0644 LICENSE %{buildroot}/usr/share/doc/breeze-core/LICENSE

%pre
@PREINSTALL@

%post
@POSTINSTALL@

%preun
@PREREMOVE@

%postun
@POSTREMOVE@

%files
/usr/bin/breeze-core
/usr/lib/breeze-core
/usr/lib/systemd/system/breeze-core.service
%dir %attr(0750,breeze,breeze) /etc/breeze-core
%config(noreplace) %attr(0640,root,breeze) /etc/breeze-core/breeze-core.env
/usr/share/doc/breeze-core

%changelog
* @RPMDATE@ monikapurpl3 <monikapurpl3@users.noreply.github.com> - @VER@-@REL@
- Built from source. What changed in each release:
  https://github.com/monikapurpl3/breeze-core-native/wiki/Version-history
