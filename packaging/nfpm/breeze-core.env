# Breeze Core service configuration (read by the systemd unit / OpenRC / procd).
#
# BREEZE_HOST: the address to bind.
#   - For direct LAN use, set this machine's LAN IP (e.g. 192.168.1.10).
#   - Keep 127.0.0.1 if a reverse proxy (nginx/Apache/Caddy) fronts it.
#   - Never use 0.0.0.0.
BREEZE_HOST=127.0.0.1
BREEZE_PORT=8420

# Extra args for `breeze-core serve`. Add --behind-proxy when a local reverse
# proxy terminates TLS and forwards the client address, or the LAN-only admin
# checks will see the proxy instead of the client.
BREEZE_OPTS=

# --- concurrency ------------------------------------------------------------
# Both are commented out because the defaults suit a household. Uncomment only
# if you have a reason; the reason is almost always "more air conditioners than
# these numbers were chosen for".
#
# BREEZE_WORKERS: HTTP worker threads. A control request blocks about 1.8s
# waiting on a unit, so this is how many slow requests can be in flight before
# the rest queue. It is rarely the limit that matters: every operation is a
# round-trip to one specific unit and each unit is locked while its own request
# runs, so two requests for the same unit serialise no matter how many workers
# exist. The useful ceiling is roughly the number of units you own.
#BREEZE_WORKERS=8
#
# BREEZE_BG_WORKERS: how many units the background state poller contacts at
# once. 1 is a sequential walk, which is what every release before 4.0.2 did.
# Raise it when the walk stops fitting inside AC_STREAM_TICK — with a second
# per unit, more than about five units means each tick starts later than the
# last and the stream lags the units it reports on. This is NOT a count of
# background threads: the timer runner, the scheduler and the poller are one
# thread each and must stay that way, because a second scheduler would fire
# every program twice.
#BREEZE_BG_WORKERS=1
